# BioSense with the real agents, in one container: this is the hosted product.
#
# The difference from deploy/Dockerfile is the whole point of the file. That
# image holds no model credentials and cannot call an LLM; it serves the
# deterministic demonstration path and is safe on a public URL for that reason.
# This image runs the actual discovery agents, so it holds a model key — and
# therefore it also carries the caps in biosense/production/budget.py, which the
# other image has no need of.
#
# Three processes, one filesystem, one service:
#
#   BioSense app      0.0.0.0:$PORT        the only thing exposed
#   Omnigent server   127.0.0.1:6767       --agent discovery_loop at boot
#   Omnigent host     -> loopback server   the server launches runners on demand
#
# Why one container rather than a service each: the agents write their artifacts
# to the filesystem and BioSense reads them from the filesystem
# (biosense/production/ingest.py). Co-locating the three processes removes the
# artifact-transport problem instead of solving it, and the runner gets
# BioSense's code, dependencies, deterministic tools and simulator by
# construction, because it is the same image. A managed sandbox host would need
# all of that bootstrapped into a generic image on every launch, plus a paid
# third-party provider account, to arrive at the same place.
#
# Cost of that choice, stated plainly: one crash takes all three processes, and
# this container holds a model key. deploy/start-ai.sh restarts the runtime
# processes, and the caps bound what the key can spend.
FROM python:3.12-slim

# Bubblewrap is the agents' OS sandbox. Omnigent wraps every agent shell and file
# tool in it on Linux, and without it each of those tools fails before it starts:
# a real run dispatched its specialists, and none of them could write a byte
# ("linux_bwrap sandbox requires the 'bwrap' binary on PATH"). The agents are not
# run unsandboxed instead — this container holds a model key — and BioSense
# refuses a real run with `agent_sandbox_unavailable` when bwrap cannot start.
RUN apt-get update \
 && apt-get install -y --no-install-recommends bubblewrap \
 && rm -rf /var/lib/apt/lists/*

# Optional: R with DESeq2 and edgeR from Debian's Bioconductor packages, so the
# external-tool adapter's count-based differential expression can run here.
# Off by default — it adds several hundred MB to the image. Set the build
# variable BIOSENSE_WITH_R=1 (on Railway: a service variable) to include it;
# the tool registry finds Rscript on PATH and registers the tools by itself.
ARG BIOSENSE_WITH_R=0
RUN if [ "$BIOSENSE_WITH_R" = "1" ]; then \
      apt-get update \
      && apt-get install -y --no-install-recommends r-base-core r-bioc-deseq2 r-bioc-edger \
      && rm -rf /var/lib/apt/lists/*; \
    fi

RUN pip install --no-cache-dir uv==0.12.23

WORKDIR /app
ENV UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/app/.venv \
    PYTHONUNBUFFERED=1

# Dependencies first. `--extra omnigent` is the one line that makes this image
# different in kind: it installs the client library BioSense imports AND the
# `omnigent` command this container runs, from the same lockfile, so there is
# nothing to install by hand and no version to drift.
COPY pyproject.toml uv.lock ./
# `--extra singlecell` adds the .h5ad reader (anndata + h5py, small), so the
# single-cell pseudobulk comparison is registered instead of "needs an install".
RUN uv sync --locked --extra omnigent --extra singlecell --no-install-project

COPY agent_tools.py output.schema.json agent_prompt.md ./
COPY biosense/ ./biosense/
COPY standins/ ./standins/
COPY schemas/ ./schemas/
COPY qc_profiles/ ./qc_profiles/
COPY process_reference/ ./process_reference/
COPY bioinfo_knowledge/ ./bioinfo_knowledge/
COPY analysis_agent/ ./analysis_agent/
COPY examples/ ./examples/
COPY webapp/ ./webapp/
COPY benchmarks/ ./benchmarks/
# The committed project templates (ipsc_macrophage, cart_expansion): what a run
# and the system check load when no account project of that name exists.
COPY projects/ ./projects/
COPY scripts/ ./scripts/
COPY docs/ ./docs/
# The agent bundle itself: the orchestrator prompt and its five specialists.
# This is what `--agent` registers, and the reason this image can do the work.
COPY discovery_loop/ ./discovery_loop/
COPY deploy/start-ai.sh ./deploy/start-ai.sh
RUN uv sync --locked --extra omnigent --extra singlecell

# One volume, mounted at /app/data, holding both durable things:
#
#   /app/data/runs      run artifacts and the run journals
#   /app/data/private   the private data root, which is where accounts' PROJECTS
#                       live. Without this on the volume, every project a
#                       scientist creates is lost on the next redeploy — the
#                       image's filesystem is ephemeral and a project is a file.
#
# Both are inside the runner's workspace (/app), and that is not cosmetic: the
# agents write under the run directory relative to the workspace, and
# runtime.check_workspace REFUSES to start a real run if BioSense is reading
# anywhere else — because such a run would succeed and produce artifacts nobody
# ever sees. The two roots must also stay disjoint, which `roots.assert_disjoint`
# enforces at startup: a server rooted inside the private root would serve it.
ENV RUNS_DIR=/app/data/runs \
    BIOSENSE_PRIVATE_DATA=/app/data/private \
    PORT=8000 \
    BIOSENSE_OMNIGENT_PORT=6767 \
    BIOSENSE_RUNTIME_MODE=local \
    BIOSENSE_ALLOWED_RUNTIMES=synthetic,local \
    BIOSENSE_OMNIGENT_WORKSPACE=/app \
    BIOSENSE_HOSTED=1 \
    BIOSENSE_PUBLIC_DEMO=1 \
    BIOSENSE_AGENT_MODEL=claude-opus-5 \
    OMNIGENT_LOCAL_SINGLE_USER=1 \
    OMNIGENT_HOST_NO_OPEN=1
RUN mkdir -p /app/data/runs /app/data/private

# A non-root user, as in the other image: this process accepts input from the
# internet and starts work. uid 1000 for the same reason. The container starts as
# root only for deploy/entrypoint-ai.sh, which fixes the volume's ownership,
# starts the model-key proxy as `keyholder` when the agents' sandbox is off, and
# then becomes `biosense` for everything else (setpriv, no capabilities kept).
ENV UV_CACHE_DIR=/home/biosense/.cache/uv \
    HOME=/home/biosense
COPY deploy/entrypoint-ai.sh ./deploy/entrypoint-ai.sh
RUN useradd --uid 1000 --create-home --home-dir /home/biosense biosense \
 && useradd --system --no-create-home --shell /usr/sbin/nologin keyholder \
 && mkdir -p "$UV_CACHE_DIR" \
 && chmod +x /app/deploy/start-ai.sh /app/deploy/entrypoint-ai.sh \
 && chown -R biosense /app /home/biosense

EXPOSE 8000
# Liveness only, and deliberately so: /healthz answers as soon as the web process
# is up. Pointing a platform healthcheck at /readyz instead would restart the
# container while the runtime is still coming up, and keep restarting it if a
# model key were missing — taking the demonstration path down with it.
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s \
  CMD python -c "import os,urllib.request; urllib.request.urlopen(f'http://127.0.0.1:{os.environ.get(\"PORT\",8000)}/healthz')"

CMD ["/app/deploy/entrypoint-ai.sh"]
