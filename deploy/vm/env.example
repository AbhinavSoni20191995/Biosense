# deploy/vm/.env — the VM's settings. setup.sh writes this file for you, readable
# by root only. It is gitignored: never commit a real one.

# The address people will use. setup.sh suggests <your-ip-with-dashes>.sslip.io,
# which needs no DNS setup; a domain of your own works too (point its A record at
# the VM first).
BIOSENSE_DOMAIN=203-0-113-10.sslip.io

# Accounts are kept by BioSense itself (sign up on the site). Optional:
# the operator account(s) by email, a sign-up code only your lab knows, and how
# many real AI runs each account gets (default 5).
# BIOSENSE_ADMIN_USER_IDS=you@yourlab.example
# BIOSENSE_SIGNUP_CODE=
# BIOSENSE_RUNS_PER_ACCOUNT=5

# The model key. Only the runtime processes read it; the agents' tools never see it.
ANTHROPIC_API_KEY=
