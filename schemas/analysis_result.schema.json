{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/biosense/analysis-result-v2.0",
  "title": "AnalysisResult 2.0: deterministic evidence about one named uncertainty",
  "description": "What a tool computed, what it means for the process, and what it is not. An AnalysisResult is always evidence_class derived_analysis; the class and visibility of the data it was computed FROM are kept in source_evidence_class and source_visibility, so an analysis of private data is a derived analysis with a private source rather than a private object. It carries candidate process parameters in the loop's existing lever vocabulary, and it can never change one: only a validated revise_protocol decision does that.",
  "type": "object",
  "required": [
    "schema_version",
    "analysis_id",
    "created_at",
    "plan_ref",
    "question",
    "uncertainty_ref",
    "evidence_class",
    "source_evidence_class",
    "source_visibility",
    "datasets",
    "method",
    "quality_control",
    "statistics",
    "key_findings",
    "process_implications",
    "candidate_process_parameters",
    "confidence",
    "decision_relevance",
    "citable",
    "provenance",
    "limitations"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "analysis_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{3,96}$"
    },
    "created_at": {
      "type": "string"
    },
    "plan_ref": {
      "type": "string"
    },
    "loop_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "iteration": {
      "type": [
        "integer",
        "null"
      ]
    },
    "question": {
      "type": "string"
    },
    "uncertainty_ref": {
      "type": "object",
      "required": [
        "kind",
        "ref",
        "statement"
      ],
      "properties": {
        "kind": {
          "enum": [
            "hypothesis",
            "evidence_gap"
          ]
        },
        "ref": {
          "type": "string"
        },
        "statement": {
          "type": "string"
        },
        "raised_by": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_artifact": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "evidence_class": {
      "const": "derived_analysis",
      "description": "A computed result is always derived evidence, whatever it was computed from."
    },
    "source_evidence_class": {
      "enum": [
        "public_dataset",
        "private_user_dataset",
        "derived_analysis",
        "mixed",
        "synthetic_fixture"
      ],
      "description": "What the inputs were. 'mixed' when datasets of different classes were combined."
    },
    "source_visibility": {
      "enum": [
        "public",
        "private",
        "mixed"
      ],
      "description": "The most restrictive visibility among the inputs. Any private input makes the result private to handle."
    },
    "parent_dataset_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "datasets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "dataset_id",
          "title",
          "source",
          "visibility",
          "evidence_class",
          "checksums"
        ],
        "properties": {
          "dataset_id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "accession": {
            "type": [
              "string",
              "null"
            ]
          },
          "visibility": {
            "enum": [
              "public",
              "private"
            ]
          },
          "evidence_class": {
            "type": "string"
          },
          "checksums": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "sha256 of every input file, so the result is traceable to the exact bytes"
          }
        }
      }
    },
    "method": {
      "type": "object",
      "required": [
        "tool",
        "tool_version",
        "software",
        "analysis_type",
        "parameters"
      ],
      "properties": {
        "tool": {
          "type": "string"
        },
        "tool_version": {
          "type": "string"
        },
        "software": {
          "type": "string",
          "description": "Library and version that did the arithmetic"
        },
        "analysis_type": {
          "type": "string"
        },
        "parameters": {
          "type": "object"
        },
        "external_execution": {
          "type": [
            "object",
            "null"
          ],
          "description": "Present when an external tool ran: command, versions, checksums, exit status, duration, environment identity"
        }
      }
    },
    "comparison": {
      "type": [
        "object",
        "null"
      ]
    },
    "quality_control": {
      "type": "object",
      "description": "What was checked before the statistics were believed, and what it found.",
      "required": [
        "checks",
        "passed"
      ],
      "properties": {
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "check",
              "status",
              "detail"
            ],
            "properties": {
              "check": {
                "type": "string"
              },
              "status": {
                "enum": [
                  "PASS",
                  "WARN",
                  "FAIL"
                ]
              },
              "detail": {
                "type": "string"
              }
            }
          }
        },
        "passed": {
          "type": "boolean"
        }
      }
    },
    "statistics": {
      "type": "array",
      "description": "One row per readout compared. Raw numbers, computed by code, never written by a model.",
      "items": {
        "type": "object",
        "required": [
          "readout",
          "test",
          "effect",
          "effect_type",
          "p_value",
          "q_value",
          "n"
        ],
        "properties": {
          "readout": {
            "type": "string"
          },
          "test": {
            "type": "string"
          },
          "group_a": {
            "type": [
              "string",
              "null"
            ]
          },
          "group_b": {
            "type": [
              "string",
              "null"
            ]
          },
          "mean_a": {
            "type": [
              "number",
              "null"
            ]
          },
          "mean_b": {
            "type": [
              "number",
              "null"
            ]
          },
          "sd_a": {
            "type": [
              "number",
              "null"
            ]
          },
          "sd_b": {
            "type": [
              "number",
              "null"
            ]
          },
          "n_a": {
            "type": [
              "integer",
              "null"
            ]
          },
          "n_b": {
            "type": [
              "integer",
              "null"
            ]
          },
          "effect": {
            "type": [
              "number",
              "null"
            ]
          },
          "effect_type": {
            "type": "string",
            "description": "e.g. difference_in_percentage_points, log2_fold_change"
          },
          "ci_low": {
            "type": [
              "number",
              "null"
            ]
          },
          "ci_high": {
            "type": [
              "number",
              "null"
            ]
          },
          "ci_method": {
            "type": [
              "string",
              "null"
            ]
          },
          "p_value": {
            "type": [
              "number",
              "null"
            ]
          },
          "q_value": {
            "type": [
              "number",
              "null"
            ],
            "description": "Benjamini-Hochberg across the readouts in this result"
          },
          "n": {
            "type": "integer"
          },
          "direction": {
            "enum": [
              "increase",
              "decrease",
              "no_change",
              "unknown"
            ]
          },
          "note": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "key_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "finding",
          "basis"
        ],
        "properties": {
          "finding": {
            "type": "string"
          },
          "basis": {
            "type": "string",
            "description": "The statistic that supports it, by readout and number"
          }
        }
      }
    },
    "process_implications": {
      "type": "array",
      "description": "What the finding could mean for the process. A possibility, stated as one.",
      "items": {
        "type": "object",
        "required": [
          "implication",
          "rests_on"
        ],
        "properties": {
          "implication": {
            "type": "string"
          },
          "rests_on": {
            "type": "string"
          },
          "alternative_explanations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "candidate_process_parameters": {
      "type": "array",
      "description": "Suggestions in the loop's existing lever vocabulary. Suggestions only: nothing here changes a protocol. The orchestrator weighs them with every other source and a revise_protocol decision still has to pass the envelope.",
      "items": {
        "type": "object",
        "required": [
          "parameter",
          "direction",
          "basis",
          "confidence"
        ],
        "properties": {
          "parameter": {
            "type": "string"
          },
          "direction": {
            "enum": [
              "increase",
              "decrease",
              "shorten",
              "extend",
              "earlier",
              "later",
              "revisit"
            ]
          },
          "arm_scope": {
            "type": [
              "string",
              "null"
            ]
          },
          "basis": {
            "type": "string"
          },
          "confidence": {
            "enum": [
              "low",
              "moderate",
              "high"
            ]
          },
          "suggested_range": {
            "type": [
              "string",
              "null"
            ],
            "description": "A range to search, when the evidence supports one. Never a value to adopt."
          }
        }
      }
    },
    "confidence": {
      "enum": [
        "low",
        "moderate",
        "high"
      ]
    },
    "decision_relevance": {
      "type": "string"
    },
    "citable": {
      "const": false,
      "description": "A computed result is not a literature citation and never becomes one. A claim requires a source, a paragraph and a verbatim quote; a statistic has none."
    },
    "provenance": {
      "type": "object",
      "required": [
        "executed_at",
        "code_sha256",
        "input_checksums"
      ],
      "properties": {
        "executed_at": {
          "type": "string"
        },
        "executed_by": {
          "type": [
            "string",
            "null"
          ]
        },
        "code_sha256": {
          "type": "string"
        },
        "code_revision": {
          "type": [
            "object",
            "null"
          ]
        },
        "input_checksums": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "plan_sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "duration_s": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
