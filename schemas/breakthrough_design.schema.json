{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/biosense/breakthrough-design-v1.0",
  "title": "BreakthroughDesign 1.0: the experiment closest to the aim, past the apparatus",
  "description": "Round 1 is designed inside the process as it is. This is the experiment the orchestrator would design if the apparatus were not the limit: each lifted constraint named with what it is now, what it becomes and why it stands between the process and the aim. Only the apparatus is lifted -- the aim, its target, the QC limits and safety bounds are kept. It is a concept: not runnable on the current apparatus, not approved, and never a protocol until one is written and a named person approves it. Quantities keep their provenance; the expected outcome is a judgement range.",
  "type": "object",
  "required": ["kind", "schema_version", "project_id", "aim", "title", "why_now", "closest_to_aim",
               "gap_to_aim", "constraints_in_force", "constraints_lifted", "kept", "apparatus",
               "stages", "arms", "readouts", "decision_rule", "feasibility", "risks",
               "evidence_basis", "confidence", "status", "runnable_on_current_apparatus",
               "ready_for_wet_lab", "does_not_change", "note"],
  "additionalProperties": false,
  "$defs": {
    "text": {"type": "string", "minLength": 1},
    "refs": {"type": "array", "items": {"type": "string"}},
    "condition": {"type": "object", "required": ["factor", "value", "provenance", "refs"],
      "additionalProperties": false,
      "properties": {
        "factor": {"type": "string"}, "value": {"type": ["number", "null"]},
        "unit": {"type": ["string", "null"]},
        "provenance": {"enum": ["reported", "adapted", "design_choice", "gap"]},
        "refs": {"$ref": "#/$defs/refs"},
        "rationale": {"type": ["string", "null"]},
        "what_would_settle": {"type": ["string", "null"]}},
      "allOf": [{"if": {"properties": {"provenance": {"const": "gap"}}},
                 "then": {"properties": {"value": {"type": "null"}}}}]}
  },
  "properties": {
    "kind": {"const": "breakthrough_design"},
    "schema_version": {"type": "string"},
    "project_id": {"type": "string"},
    "run_id": {"type": ["string", "null"]},
    "created_at": {"type": ["string", "null"]},
    "created_by": {"type": ["string", "null"]},
    "requested_by": {"type": ["string", "null"]},
    "ask": {"type": ["string", "null"], "description": "What a person asked for, in their words, when they asked."},
    "aim": {"type": "string", "minLength": 10, "description": "The run's objective. Read from the request, never relaxed."},
    "title": {"type": "string", "minLength": 5},
    "why_now": {"type": "string", "minLength": 20},
    "closest_to_aim": {"type": "string", "minLength": 20},
    "gap_to_aim": {"type": "string", "minLength": 10, "description": "What the design still leaves short of the aim."},
    "first_experiment": {"type": ["object", "null"], "additionalProperties": false,
      "properties": {"round": {"type": ["integer", "null"]},
                     "commitment_sha256": {"type": ["string", "null"]},
                     "arms": {"type": "array", "items": {"type": ["string", "null"]}},
                     "culture_format": {"type": ["string", "null"]}}},
    "constraints_in_force": {"type": "array", "items": {"type": "object",
      "required": ["id", "what"], "additionalProperties": false,
      "properties": {"id": {"type": "string"}, "what": {"type": "string"},
                     "source": {"type": ["string", "null"]}}}},
    "constraints_lifted": {"type": "array", "minItems": 1, "items": {"type": "object",
      "required": ["constraint", "kind", "now", "lifted_to", "why_it_limits", "evidence_basis", "refs"],
      "additionalProperties": false,
      "properties": {
        "constraint": {"type": "string"},
        "kind": {"enum": ["vessel_format", "surface_or_matrix", "feeding_or_perfusion", "sensing",
                          "actuation_or_control", "co_culture", "scale", "duration_or_harvest",
                          "equipment_limit", "other"]},
        "refers_to": {"type": ["string", "null"]},
        "now": {"type": "string"}, "lifted_to": {"type": "string"},
        "why_it_limits": {"type": "string"},
        "evidence_basis": {"enum": ["cited", "mechanistic", "judgement"]},
        "refs": {"$ref": "#/$defs/refs"}}}},
    "kept": {"type": "array", "minItems": 2, "items": {"type": "object",
      "required": ["what", "kind", "why"], "additionalProperties": false,
      "properties": {"what": {"type": "string"}, "kind": {"enum": ["target", "qc", "safety", "other"]},
                     "why": {"type": "string"}}}},
    "apparatus": {"type": "object", "required": ["name", "description", "features", "exists", "refs"],
      "additionalProperties": false,
      "properties": {"name": {"type": "string"}, "description": {"type": "string"},
                     "features": {"type": "array", "items": {"type": "string"}},
                     "exists": {"enum": ["commercial", "published", "custom_build", "concept"]},
                     "refs": {"$ref": "#/$defs/refs"}}},
    "stages": {"type": "array", "minItems": 1, "items": {"type": "object",
      "required": ["label", "day_start", "day_end", "conditions"], "additionalProperties": false,
      "properties": {"label": {"type": "string"}, "stage_id": {"type": ["string", "null"]},
                     "day_start": {"type": "number", "minimum": 0},
                     "day_end": {"type": "number", "maximum": 365},
                     "conditions": {"type": "array", "items": {"$ref": "#/$defs/condition"}},
                     "note": {"type": ["string", "null"]}}}},
    "arms": {"type": "array", "minItems": 2, "items": {"type": "object",
      "required": ["arm_id", "label", "control", "differs"], "additionalProperties": false,
      "properties": {"arm_id": {"type": "string"}, "label": {"type": "string"},
                     "control": {"type": "boolean"}, "differs": {"type": "string"},
                     "basis": {"type": ["string", "null"]}}}},
    "readouts": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["name"],
      "additionalProperties": false,
      "properties": {"name": {"type": "string"}, "unit": {"type": ["string", "null"]},
                     "when": {"type": ["string", "null"]}}}},
    "replicates": {"type": ["integer", "null"], "minimum": 1},
    "decision_rule": {"type": "object", "required": ["if", "then"], "additionalProperties": false,
      "properties": {"if": {"type": "string", "minLength": 10}, "then": {"type": "string", "minLength": 10}}},
    "expected": {"type": ["object", "null"], "description": "An Estimate typed judgement (see estimate.schema.json): a range over the control, never a prediction or a measurement.",
      "properties": {"estimate_type": {"const": "judgement"}}},
    "feasibility": {"type": "object", "required": ["cost", "time", "build_steps"], "additionalProperties": false,
      "properties": {"cost": {"type": "string"}, "time": {"type": "string"},
                     "expertise": {"type": ["string", "null"]},
                     "build_steps": {"type": "array", "items": {"type": "string"}}}},
    "risks": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["risk", "mitigation"],
      "additionalProperties": false,
      "properties": {"risk": {"type": "string"}, "mitigation": {"type": "string"}}}},
    "evidence_basis": {"enum": ["cited", "mechanistic", "judgement"]},
    "confidence": {"enum": ["low", "moderate", "high"]},
    "refs": {"$ref": "#/$defs/refs"},
    "status": {"const": "concept"},
    "runnable_on_current_apparatus": {"const": false},
    "ready_for_wet_lab": {"const": false},
    "does_not_change": {"type": "string"},
    "note": {"type": "string"}
  }
}
